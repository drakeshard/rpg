{
  "name": "@drakeshard/rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.21.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "biome check . && pnpm check:architecture",
    "check:write": "biome check --write .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
