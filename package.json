{
  "name": "@drakeshard/rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.21.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "pnpm check:format && pnpm check:architecture && pnpm check:package",
    "check:write": "biome check --write .",
    "check:format": "biome check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:build": "node scripts/check-build-artifacts.mjs",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:test",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm check:build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
