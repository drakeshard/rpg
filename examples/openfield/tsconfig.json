{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@drakeshard/foundation/time": [".foundation-src/packages/foundation/src/time/index.ts"],
      "@drakeshard/foundation/random": [".foundation-src/packages/foundation/src/random/index.ts"],
      "@drakeshard/foundation/input": [".foundation-src/packages/foundation/src/input/index.ts"],
      "@drakeshard/foundation/input/browser": [".foundation-src/packages/foundation/src/input/browser/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
